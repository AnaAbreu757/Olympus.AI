# Copia este ficheiro para ".env" e cola as tuas chaves reais.
# O ficheiro ".env" NUNCA deve ser enviado para o GitHub (ja esta no .gitignore).

# Google Gemini (gratuita, recomendada para comecar)
GOOGLE_API_KEY=

# OpenAI GPT (opcional, requer cartao)
# OPENAI_API_KEY=

# Anthropic Claude (opcional, requer cartao)
# ANTHROPIC_API_KEY=

# Porta (localhost em dev, ignorada em producao no Render)
PORT=3000
